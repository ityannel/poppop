{
  "name": "vscode-popcorn",
  "displayName": "PopCorn Language Support Japanese — PopCorn",
  "description": "PopCorn 言語向けの日本語ホバー、データフロー表示、診断、実行コマンドを提供します。",
  "version": "1.8.1",
  "publisher": "popcorn-dev",
  "main": "./extension.js",
  "scripts": {
    "test": "node assignment-targets.test.js && node semantic-highlights.test.js && node language-features.test.js && node extension-flow.test.js"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:popcorn",
    "onCommand:popcorn.runFile",
    "onCommand:popcorn.refreshFlowHighlights",
    "onCommand:popcorn.showResults"
    ,"onCommand:popcorn.showFlowVisualizer"
  ],
  "contributes": {
    "configuration": {
      "title": "PopCorn Japanese",
      "properties": {
        "popcorn.highlightFinalAssignmentTargets": {
          "type": "boolean",
          "default": true,
          "description": "パイプラインの最終代入先を太字・斜体で表示します。"
        },
        "popcorn.visualizePipelineFlow": {
          "type": "boolean",
          "default": false,
          "description": "各 PopCorn パイプラインの下にガイドを表示します。既定ではオフです。"
        },
        "popcorn.highlightVariableFlow": {
          "type": "boolean",
          "default": true,
          "description": "カーソルまたは選択中の変数の利用箇所を背景色で表示します。"
        },
        "popcorn.highlightImplicitVariableScopes": {
          "type": "boolean",
          "default": true,
          "description": "PopCorn ストリームブロック内で @ の有効範囲を表示します。"
        },
        "popcorn.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "未定義変数、未使用代入、@ の誤用、パイプラインの書式・型に関する問題を表示します。"
        },
        "popcorn.runtimePath": {
          "type": "string",
          "default": "",
          "description": "PopCorn 実行器のパスです。通常は不要です。独自の実行器を使う場合だけ指定してください。"
        }
      }
    },
    "configurationDefaults": {
      "[popcorn]": {
        "editor.tokenColorCustomizations": {
          "textMateRules": [
            {
              "scope": "entity.name.function.popcorn",
              "settings": {
                "foreground": "#DCDCAA",
                "fontStyle": ""
              }
            },
            {
              "scope": "support.function.builtin.popcorn",
              "settings": {
                "foreground": "#DCDCAA",
                "fontStyle": ""
              }
            },
            {
              "scope": "keyword.control.flow.popcorn",
              "settings": {
                "foreground": "#C586C0",
                "fontStyle": ""
              }
            },
            {
              "scope": "variable.other.readwrite.popcorn",
              "settings": {
                "foreground": "#9CDCFE"
              }
            }
          ]
        }
      }
    },
    "languages": [
      {
        "id": "popcorn",
        "aliases": [
          "PopCorn",
          "pop"
        ],
        "extensions": [
          ".pop",
          ".popcorn"
        ],
        "icon": {
          "light": "./po.png",
          "dark": "./po.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "popcorn",
        "scopeName": "source.popcorn",
        "path": "./syntaxes/popcorn.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "popcorn.runFile",
        "title": "PopCorn: ファイルを実行",
        "icon": "$(play)"
      },
      {
        "command": "popcorn.refreshFlowHighlights",
        "title": "PopCorn: データフロー表示を更新"
      },
      {
        "command": "popcorn.showResults",
        "title": "PopCorn: 実行結果を表示"
      },
      {
        "command": "popcorn.showFlowVisualizer",
        "title": "PopCorn: データフローを表示",
        "icon": "$(graph)"
      }
    ],
    "keybindings": [
      {
        "command": "popcorn.runFile",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorTextFocus && resourceLangId == popcorn"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "popcorn.runFile",
          "when": "resourceLangId == popcorn",
          "group": "navigation@1"
        },
        {
          "command": "popcorn.showFlowVisualizer",
          "when": "resourceLangId == popcorn",
          "group": "navigation@2"
        }
      ]
    }
  }
}
