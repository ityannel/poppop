{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PopCorn",
  "scopeName": "source.popcorn",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#function-definition"
    },
    {
      "include": "#block-header"
    },
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.popcorn",
          "match": "//.*$"
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#properties"
        },
        {
          "include": "#fork-label"
        },
        {
          "include": "#processes"
        },
        {
          "include": "#variables"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#implicit-var"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "function-definition": {
      "comment": "(a, Keep) >> pop Name:  2 番目以降の大文字の引数は処理引数",
      "match": "^\\s*(?:(\\()([^()]*)(\\))|([a-z_][a-zA-Z0-9_]*))?\\s*(>>)?\\s*\\b(pop)\\s+([A-Z][a-zA-Z0-9_]*)",
      "captures": {
        "1": {
          "name": "punctuation.section.parens.begin.popcorn"
        },
        "2": {
          "patterns": [
            {
              "name": "variable.parameter.process.popcorn",
              "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
            },
            {
              "name": "variable.parameter.popcorn",
              "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.comma.popcorn",
              "match": ","
            }
          ]
        },
        "3": {
          "name": "punctuation.section.parens.end.popcorn"
        },
        "4": {
          "name": "variable.parameter.popcorn"
        },
        "5": {
          "name": "keyword.operator.pipeline.popcorn"
        },
        "6": {
          "name": "storage.type.function.popcorn"
        },
        "7": {
          "name": "entity.name.function.definition.popcorn"
        }
      }
    },
    "block-header": {
      "comment": "when 条件: / else: の分岐",
      "match": "^\\s*\\b(when|else)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.conditional.popcorn"
        }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipeline.popcorn",
          "match": ">>"
        },
        {
          "name": "keyword.operator.comparison.popcorn",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.word.popcorn",
          "match": "\\bnot\\s+in\\b"
        },
        {
          "name": "keyword.operator.word.popcorn",
          "match": "\\b(in|and|or|not)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.popcorn",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.popcorn",
          "match": "\\b(when|else)\\b"
        },
        {
          "name": "keyword.other.alias.popcorn",
          "match": "\\bas\\b"
        },
        {
          "name": "storage.type.function.popcorn",
          "match": "\\bpop\\b"
        },
        {
          "name": "constant.language.popcorn",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "properties": {
      "match": "(::)\\s*([a-z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.popcorn"
        },
        "2": {
          "name": "variable.other.property.popcorn"
        }
      }
    },
    "fork-label": {
      "comment": "Fork のラベル（行頭の name:）",
      "match": "^\\s*(?!(?:when|else)\\b)([a-z_][a-zA-Z0-9_]*)\\s*(:)(?!:)",
      "captures": {
        "1": {
          "name": "entity.name.label.popcorn"
        },
        "2": {
          "name": "punctuation.separator.label.popcorn"
        }
      }
    },
    "processes": {
      "patterns": [
        {
          "name": "support.function.builtin.stream.popcorn",
          "match": "\\b(Map|Filter|Count|Reduce|Sort|SortDesc|Group|Fork|Update|Check|Loop|Try|Catch)\\b"
        },
        {
          "name": "support.function.builtin.control.popcorn",
          "match": "\\b(Return|Break|Throw)\\b"
        },
        {
          "name": "support.function.builtin.popcorn",
          "match": "\\b(Display|Input|ReadFile|WriteFile|Fetch|PostFetch|HttpRequest|Type|Sleep|Add|Div|Sum|Max|Min|Average|Round|Abs|Floor|Ceil|Sqrt|Pow|Exp|Log|Sin|Cos|Tan|Pi|E|Trim|Unique|Flatten|Enumerate|FromEntries|GetPath|Env|Args|Num|Str|Bool|List|Array|Dict|Length|Reverse|Uppercase|Lowercase|Split|Replace|Join|Get|Set|Remove|Keys|Values|Entries|Merge|Contains|Append|Slice|Format|Now|Random|ToJson|FromJson|Range|Debug|Zip)\\b"
        },
        {
          "name": "entity.name.function.popcorn",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.readwrite.popcorn",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "implicit-var": {
      "patterns": [
        {
          "name": "variable.language.implicit.popcorn",
          "match": "@"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.popcorn",
          "match": "\\.(?=\\s*(?://.*)?$)"
        },
        {
          "name": "punctuation.section.block.begin.popcorn",
          "match": ":(?!:)"
        },
        {
          "name": "punctuation.separator.comma.popcorn",
          "match": ","
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.popcorn",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.popcorn"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.popcorn"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.popcorn",
              "match": "\\\\[ntr\\\\\\\"']"
            },
            {
              "name": "invalid.illegal.escape.popcorn",
              "match": "\\\\."
            },
            {
              "name": "constant.character.escape.brace.popcorn",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.single.popcorn",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.popcorn"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.popcorn"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.popcorn",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.other.raw.popcorn",
          "begin": "`",
          "end": "`|$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.popcorn"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.popcorn"
            }
          }
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.popcorn",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.popcorn"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.popcorn"
        }
      },
      "contentName": "source.popcorn.embedded",
      "patterns": [
        {
          "include": "#dict-in-interpolation"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "dict-in-interpolation": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#dict-in-interpolation"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.popcorn",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    }
  }
}
