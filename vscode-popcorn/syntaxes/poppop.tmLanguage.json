{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PopCorn",
  "patterns": [
    { "include": "#comments" },
    { "include": "#operators" },
    { "include": "#keywords" },
    { "include": "#uppercase-functions" },
    { "include": "#lowercase-variables" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#implicit-var" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.popcorn",
          "match": "//.*$"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipeline.popcorn",
          "match": ">>"
        },
        {
          "name": "punctuation.accessor.popcorn",
          "match": "::"
        },
        {
          "name": "keyword.operator.comparison.popcorn",
          "match": "==|!=|<=|>=|<|>|\\bin\\b"
        },
        {
          "name": "keyword.operator.logical.popcorn",
          "match": "\\b(and|or)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.popcorn",
          "match": "\\+|\\-|\\*|\\/|%"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.popcorn",
          "match": "\\b(when|else|as|pop|not)\\b"
        },
        {
          "name": "support.function.builtin.popcorn",
          "match": "\\b(Display|Input|ReadFile|WriteFile|Fetch|PostFetch|HttpRequest|Set|Remove|Keys|Values|Entries|Merge|Num|Str|Bool|List|Dict|Type|Sleep|Add|Div|Sum|Max|Min|Average|Round|Abs|Length|Reverse|Uppercase|Lowercase|Split|Replace|Join|Get|Contains|Append|Slice|Format|Now|Random|ToJson|FromJson|Array|Range|Return|Break|Debug|Throw|Expect|Assert|ExpectError|Update|Map|Filter|Count|Reduce|Zip|Loop|Fork|Sort|SortDesc|Group|Check|Try|Catch)\\b"
        },
        {
          "name": "constant.language.popcorn",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "uppercase-functions": {
      "patterns": [
        {
          "name": "entity.name.function.popcorn",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "lowercase-variables": {
      "patterns": [
        {
          "name": "variable.other.readwrite.popcorn",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "implicit-var": {
      "patterns": [
        {
          "name": "variable.language.implicit.popcorn",
          "match": "@"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.popcorn",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.popcorn",
              "match": "\\\\."
            },
            {
              "name": "constant.character.escape.brace.popcorn",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "name": "variable.other.interpolated.popcorn",
              "match": "\\{[^\\}]+\\}"
            }
          ]
        },
        {
          "name": "string.quoted.single.popcorn",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.popcorn",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.other.raw.popcorn",
          "begin": "`",
          "end": "`|$"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.popcorn",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    }
  },
  "scopeName": "source.popcorn"
}
